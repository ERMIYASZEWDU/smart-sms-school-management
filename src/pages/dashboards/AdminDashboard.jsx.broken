                  <span className="font-semibold text-gray-800">{item.value}</span>
                </motion.div>
              ))}
            </div>
          </motion.div>
        </div>

        {/* Attendance and Fees Status */}
        <div className="grid lg:grid-cols-3 gap-6 mb-6">
          {/* Attendance Overview */}
          <motion.div
