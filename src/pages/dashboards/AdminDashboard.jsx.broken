                <span className="font-semibold text-gray-800">₹ 18,75,500 (75%)</span>
              </div>
              <div className="flex items-center justify-between">
                <span className="flex items-center gap-2"><span className="w-2 h-2 bg-orange-500 rounded-full"></span><span className="text-gray-600">Pending</span></span>
                <span className="font-semibold text-gray-800">₹ 5,75,000 (23%)</span>
              </div>
              <div className="flex items-center justify-between">
                <span className="flex items-center gap-2"><span className="w-2 h-2 bg-red-500 rounded-full"></span><span className="text-gray-600">Overdue</span></span>
                <span className="font-semibold text-gray-800">₹ 50,000 (2%)</span>
              </div>
            </div>
