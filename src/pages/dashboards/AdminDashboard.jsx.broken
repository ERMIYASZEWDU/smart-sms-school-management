            <div className="space-y-3 max-h-64 overflow-y-auto">
              {[
                { icon: '🎓', title: 'School will remain closed on 25 May 2024 on account of Public Holiday', time: '2 hours ago', color: 'bg-red-50 border-red-200' },
                { icon: '📅', title: 'Final exam schedule has been published', time: '6 hours ago', color: 'bg-green-50 border-green-200' },
                { icon: '💰', title: 'Fee reminder for May month has been sent to parents', time: '1 day ago', color: 'bg-blue-50 border-blue-200' },
                { icon: '👥', title: 'Parent-Teacher meeting on 30 May 2024', time: '2 days ago', color: 'bg-purple-50 border-purple-200' }
              ].map((notif, idx) => (
                <motion.div
                  key={idx}
