            >
              Dashboard
            </motion.h1>
            <p className="text-gray-600 mt-1">Welcome back, Admin!</p>
          </div>
          
          <div className="flex gap-3 w-full sm:w-auto">
            {/* Date Picker */}
            <div className="relative">
