                ]} cx="50%" cy="50%" innerRadius={45} outerRadius={70} dataKey="value">
                  {[
                    { name: 'Collected', value: 75, fill: '#10b981' },
                    { name: 'Pending', value: 20, fill: '#f59e0b' },
                    { name: 'Overdue', value: 5, fill: '#ef4444' }
