                whileTap={{ scale: 0.98 }}
                onClick={stat.onClick}
                className={`${stat.bgColor} border ${stat.borderColor} rounded-lg p-5 transition-all cursor-pointer`}
              >
                <div className="flex items-start justify-between mb-3">
                  <div className={`p-2 rounded-lg ${stat.textColor} bg-white/50`}>
                    <Icon size={20} />
                  </div>
                  <span className={`text-xs font-semibold ${stat.textColor} px-2 py-1 rounded-full bg-white/60`}>
                    +3.2%
                  </span>
                </div>
                <p className="text-gray-600 text-sm font-medium">{stat.label}</p>
                <motion.p 
                  initial={{ opacity: 0 }}
                  animate={{ opacity: 1 }}
                  transition={{ delay: 0.3 + idx * 0.08 }}
                  className={`text-2xl font-bold ${stat.textColor} mt-1`}
                >
                  {stat.value}
                </motion.p>
                <p className="text-xs text-gray-500 mt-2">{stat.subtitle}</p>
              </motion.div>
            )
          })}
        </div>
                <motion.p 
                  initial={{ opacity: 0 }}
                  animate={{ opacity: 1 }}
                  transition={{ delay: 0.3 + idx * 0.08 }}
                  className={`text-2xl font-bold ${stat.textColor} mt-1`}
                >
                  {stat.value}
                </motion.p>
                <p className="text-xs text-gray-500 mt-2">{stat.subtitle}</p>
              </motion.div>
            )
          })}
        </div>

        {/* Main Grid */}
        <div className="grid lg:grid-cols-3 gap-6 mb-6">
          {/* Fee Collection Chart */}
          <motion.div
            initial={{ opacity: 0, scale: 0.95, y: 20 }}
